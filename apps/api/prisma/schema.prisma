generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(80)
  email        String?    @unique @db.VarChar(180)
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name") @db.VarChar(180)
  isActive     Boolean    @default(true) @map("is_active")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles        UserRole[]
  sessions     Session[]
  auditLogs    AuditLog[]
  reviewedAttendanceFlags AttendanceFlag[] @relation("AttendanceFlagReviewer")
  createdAttendanceBlocks AttendanceBlock[] @relation("AttendanceBlockCreator")
  employeeMappings EmployeeMapping[] @relation("EmployeeMappingMatcher")
  createdShiftAssignments EmployeeShiftAssignment[]
  submittedShiftAssignments EmployeeShiftAssignment[] @relation("EmployeeShiftAssignmentSubmitter")
  reviewedShiftAssignments EmployeeShiftAssignment[] @relation("EmployeeShiftAssignmentReviewer")
  createdGroups Group[] @relation("GroupCreator")
  submittedGroups Group[] @relation("GroupSubmitter")
  reviewedGroups Group[] @relation("GroupReviewer")
  submittedMembershipChanges GroupMembershipChange[] @relation("MembershipChangeSubmitter")
  reviewedMembershipChanges GroupMembershipChange[] @relation("MembershipChangeReviewer")
  declaredOvertime OvertimeDeclaration[] @relation("OvertimeDeclarer")
  approvedOvertime OvertimeDeclaration[] @relation("OvertimeApprover")
  declaredCompensations AbsenceCompensation[] @relation("CompensationDeclarer")
  approvedCompensations AbsenceCompensation[] @relation("CompensationApprover")
  declaredSickLeaves SickLeaveDeclaration[] @relation("SickLeaveDeclarer")
  declaredLeaves LeaveDeclaration[] @relation("LeaveDeclarer")
  approvedLeaves LeaveDeclaration[] @relation("LeaveApprover")
  declaredAbsenceReversals AbsenceReversalRequest[] @relation("AbsenceReversalDeclarer")
  approvedAbsenceReversals AbsenceReversalRequest[] @relation("AbsenceReversalApprover")
  reviewedPresumedAbsences PresumedAbsence[]
  advancedTreatmentConfirmations AdvancedTreatmentConfirmation[] @relation("AdvancedTreatmentConfirmer")
  advancedTreatmentFreezes AdvancedTreatmentFreeze[] @relation("AdvancedTreatmentFreezer")
  subUnitAccess UserSubUnitAccess[]
  notifications Notification[] @relation("NotificationRecipient")
  createdChatConversations ChatConversation[] @relation("ChatConversationCreator")
  chatParticipants ChatParticipant[]
  sentChatMessages ChatMessage[] @relation("ChatMessageSender")

  @@map("users")
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  recipientUserId String           @map("recipient_user_id") @db.Uuid
  type            NotificationType
  title           String           @db.VarChar(180)
  message         String
  entityType      String?          @map("entity_type") @db.VarChar(120)
  entityId        String?          @map("entity_id") @db.Uuid
  isRead          Boolean          @default(false) @map("is_read")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient       User             @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, isRead, createdAt])
  @@index([type])
  @@index([entityType, entityId])
  @@map("notifications")
}

model ChatConversation {
  id           String               @id @default(uuid()) @db.Uuid
  type         ChatConversationType
  name         String?              @db.VarChar(160)
  createdById  String?              @map("created_by") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy    User?                @relation("ChatConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([createdById])
  @@index([createdAt])
  @@map("chat_conversations")
}

model ChatParticipant {
  conversationId String           @map("conversation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  lastReadAt     DateTime?        @map("last_read_at") @db.Timestamptz(6)

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  senderId       String?          @map("sender_id") @db.Uuid
  content        String
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  editedAt       DateTime?        @map("edited_at") @db.Timestamptz(6)

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?            @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("chat_messages")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(60)
  name        String           @db.VarChar(120)
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  module      String           @db.VarChar(80)
  action      String           @db.VarChar(80)
  description String?

  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(120)
  entityId   String?  @map("entity_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent")
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

enum EmployeeStatus {
  ACTIVE
  RESIGNED

  @@map("employee_status")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("day_of_week")
}

enum PunchDirection {
  CHECK_IN
  CHECK_OUT
  UNKNOWN

  @@map("punch_direction")
}

enum PunchShiftStatus {
  ON_TIME
  LATE
  EARLY
  OUT_OF_WINDOW
  UNMATCHED

  @@map("punch_shift_status")
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
  FLEXIBLE
  REPOS
  SEC_MORNING
  SEC_NIGHT

  @@map("shift_type")
}

enum ShiftAssignmentVia {
  individual
  group

  @@map("shift_assignment_via")
}

enum ApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED

  @@map("approval_status")
}

enum AttendanceSummaryStatus {
  PRESENT
  ABSENT
  SICK
  ACCIDENT
  LEAVE
  COMPENSATED
  ABSENCE_REVERSED
  REST
  INCOMPLETE

  @@map("attendance_summary_status")
}

enum OvertimeRateType {
  RATE_50
  RATE_75
  RATE_100

  @@map("overtime_rate_type")
}

enum LeaveType {
  ANNUEL
  EXCEPTIONNEL
  SANS_SOLDE
  MATERNITE

  @@map("leave_type")
}

enum ExceptionalLeaveReason {
  MARIAGE_EMPLOYE
  NAISSANCE_ENFANT
  MARIAGE_ENFANT
  DECES_CONJOINT
  DECES_PARENT_PROCHE
  CIRCONCISION_FILS
  HAJJ

  @@map("exceptional_leave_reason")
}

enum NotificationType {
  PENDING_APPROVAL
  APPROVAL_RESULT
  OVERTIME_DECLARED
  COMPENSATION_DECLARED
  SICK_LEAVE_DECLARED
  LEAVE_DECLARED
  SYNC_ERROR
  CHAT_MESSAGE
  SYSTEM

  @@map("notification_type")
}

enum PresumedAbsenceStatus {
  PENDING_REVIEW
  CONFIRMED
  REJECTED

  @@map("presumed_absence_status")
}

enum ChatConversationType {
  DIRECT
  GROUP

  @@map("chat_conversation_type")
}

enum PayrollMapTarget {
  ABSENCE
  OVERTIME_50
  OVERTIME_75
  OVERTIME_100
  SICK
  ACCIDENT
  COMPENSATION
  IGNORED

  @@map("payroll_map_target")
}

model Employee {
  id             String             @id @default(uuid()) @db.Uuid
  zktecoId       String             @unique @map("zkteco_id") @db.VarChar(80)
  groupId        String?            @map("group_id") @db.Uuid
  biotimeCode    String?            @map("biotime_code") @db.VarChar(120)
  localMatricule String?            @map("local_matricule") @db.VarChar(120)
  employeeCode   String             @unique @map("employee_code") @db.VarChar(80)
  fullName       String             @map("full_name") @db.VarChar(180)
  department     String?            @db.VarChar(160)
  phone          String?            @db.VarChar(80)
  hireDate       DateTime?          @map("hire_date") @db.Date
  resignedAt     DateTime?          @map("resigned_at") @db.Date
  status         EmployeeStatus     @default(ACTIVE)
  sourceUpdatedAt DateTime?         @map("source_updated_at") @db.Timestamptz(6)
  sourcePayload   Json?             @map("source_payload")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  shiftAssignments ShiftAssignment[]
  attendancePunches AttendancePunch[]
  attendanceBlocks  AttendanceBlock[]
  resignRecords     ResignRecord[]
  sapMappings       EmployeeMapping[]
  sapDirectoryRecords SapEmployeeDirectory[]
  group              Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  plannedShiftAssignments EmployeeShiftAssignment[]
  groupMembershipChanges GroupMembershipChange[]
  overtimeDeclarations OvertimeDeclaration[]
  absenceCompensations AbsenceCompensation[]
  sickLeaveDeclarations SickLeaveDeclaration[]
  leaveDeclarations LeaveDeclaration[]
  absenceReversalRequests AbsenceReversalRequest[]
  annualLeaveBalances AnnualLeaveBalance[]
  summaryRecords AttendanceSummaryRecord[]
  presumedAbsences PresumedAbsence[]
  advancedTreatmentConfirmations AdvancedTreatmentConfirmation[]
  advancedTreatmentFreezes AdvancedTreatmentFreeze[]

  @@index([groupId])
  @@index([status])
  @@index([fullName])
  @@map("employees")
}

model PresumedAbsence {
  id           String                 @id @default(uuid()) @db.Uuid
  employeeId   String                 @map("employee_id") @db.Uuid
  date         DateTime               @db.Date
  detectedAt   DateTime               @default(now()) @map("detected_at") @db.Timestamptz(6)
  basis        String                 @default("no_punch_heuristic") @db.VarChar(80)
  status       PresumedAbsenceStatus  @default(PENDING_REVIEW)
  reviewedById String?                @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?              @map("reviewed_at") @db.Timestamptz(6)
  reviewNote   String?                @map("review_note")

  employee     Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy   User?                  @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@index([reviewedById])
  @@map("presumed_absences")
}

enum AdvancedTreatmentRiskLevel {
  HIGH
  MEDIUM
  LOW

  @@map("advanced_treatment_risk_level")
}

model AdvancedTreatmentConfirmation {
  id            String                     @id @default(uuid()) @db.Uuid
  employeeId    String                     @map("employee_id") @db.Uuid
  periodStart   DateTime                   @map("period_start") @db.Date
  periodEnd     DateTime                   @map("period_end") @db.Date
  riskLevel     AdvancedTreatmentRiskLevel @map("risk_level")
  emptyDays     Int                        @default(0) @map("empty_days")
  punchedDays   Int                        @default(0) @map("punched_days")
  justifiedDays Int                        @default(0) @map("justified_days")
  bankAccount   String?                    @map("bank_account") @db.VarChar(120)
  note          String?
  confirmedById String?                    @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime                   @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee      Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  confirmedBy   User?                      @relation("AdvancedTreatmentConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, periodStart, periodEnd])
  @@index([periodStart, periodEnd])
  @@index([riskLevel])
  @@index([confirmedById])
  @@map("advanced_treatment_confirmations")
}

model AdvancedTreatmentFreeze {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  frozenById  String?  @map("frozen_by") @db.Uuid
  frozenAt    DateTime @default(now()) @map("frozen_at") @db.Timestamptz(6)
  reason      String?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  frozenBy    User?    @relation("AdvancedTreatmentFreezer", fields: [frozenById], references: [id], onDelete: SetNull)

  @@unique([employeeId, periodStart, periodEnd])
  @@index([periodStart, periodEnd])
  @@index([frozenById])
  @@map("advanced_treatment_freezes")
}

model ShiftDefinition {
  id             String    @id @default(uuid()) @db.Uuid
  shiftType      ShiftType @unique @map("shift_type")
  label          String    @db.VarChar(80)
  startTime      String?   @map("start_time") @db.VarChar(5)
  endTime        String?   @map("end_time") @db.VarChar(5)
  spansMidnight  Boolean   @default(false) @map("spans_midnight")
  marginMinutes  Int       @default(90) @map("margin_minutes")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments    EmployeeShiftAssignment[]

  @@map("shift_definitions")
}

model EmployeeShiftAssignment {
  id                String             @id @default(uuid()) @db.Uuid
  employeeId        String             @map("employee_id") @db.Uuid
  date              DateTime           @db.Date
  shiftDefinitionId String             @map("shift_definition_id") @db.Uuid
  assignedVia       ShiftAssignmentVia @map("assigned_via")
  sourceGroupId     String?            @map("source_group_id") @db.Uuid
  createdById       String?            @map("created_by") @db.Uuid
  submissionId      String?            @map("submission_id") @db.Uuid
  status            ApprovalStatus     @default(APPROVED)
  submittedById     String?            @map("submitted_by_id") @db.Uuid
  submittedAt       DateTime?          @map("submitted_at") @db.Timestamptz(6)
  reviewedById      String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason   String?            @map("rejection_reason")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftDefinition   ShiftDefinition    @relation(fields: [shiftDefinitionId], references: [id], onDelete: Restrict)
  sourceGroup       Group?             @relation(fields: [sourceGroupId], references: [id], onDelete: SetNull)
  createdBy         User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  submittedBy       User?              @relation("EmployeeShiftAssignmentSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy        User?              @relation("EmployeeShiftAssignmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, date, status])
  @@index([date])
  @@index([shiftDefinitionId])
  @@index([sourceGroupId])
  @@index([submissionId])
  @@index([status])
  @@map("employee_shift_assignments")
}

model Unit {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  code        String    @unique @db.VarChar(80)
  description String?
  isSouthWilaya Boolean @default(false) @map("is_south_wilaya")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  subUnits    SubUnit[]

  @@index([name])
  @@map("units")
}

model SubUnit {
  id          String    @id @default(uuid()) @db.Uuid
  unitId      String    @map("unit_id") @db.Uuid
  name        String    @db.VarChar(160)
  description String?
  isSouthWilaya Boolean @default(false) @map("is_south_wilaya")
  biotimeDepartmentCode String? @map("biotime_department_code") @db.VarChar(120)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  groups      Group[]
  userAccess  UserSubUnitAccess[]

  @@unique([unitId, name])
  @@index([name])
  @@index([biotimeDepartmentCode])
  @@map("sub_units")
}

model UserSubUnitAccess {
  userId    String   @map("user_id") @db.Uuid
  subUnitId String   @map("sub_unit_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subUnit   SubUnit  @relation(fields: [subUnitId], references: [id], onDelete: Cascade)

  @@id([userId, subUnitId])
  @@index([subUnitId])
  @@map("user_sub_unit_access")
}

model Group {
  id          String    @id @default(uuid()) @db.Uuid
  subUnitId   String    @map("sub_unit_id") @db.Uuid
  name        String    @db.VarChar(160)
  description String?
  createdById String?   @map("created_by_id") @db.Uuid
  status      ApprovalStatus @default(APPROVED)
  submittedById String?   @map("submitted_by_id") @db.Uuid
  submittedAt DateTime?   @map("submitted_at") @db.Timestamptz(6)
  reviewedById String?    @map("reviewed_by_id") @db.Uuid
  reviewedAt  DateTime?   @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String? @map("rejection_reason")
  pendingName String?     @map("pending_name") @db.VarChar(160)
  pendingDescription String? @map("pending_description")
  pendingDeleteRequested Boolean @default(false) @map("pending_delete_requested")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  subUnit     SubUnit   @relation(fields: [subUnitId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("GroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submittedBy User?     @relation("GroupSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy  User?     @relation("GroupReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  employees   Employee[]
  plannedShiftAssignments EmployeeShiftAssignment[]
  membershipChangesFrom GroupMembershipChange[] @relation("MembershipChangeFromGroup")
  membershipChangesTo GroupMembershipChange[] @relation("MembershipChangeToGroup")

  @@unique([subUnitId, name])
  @@index([name])
  @@index([status])
  @@index([createdById])
  @@map("groups")
}

model GroupMembershipChange {
  id              String         @id @default(uuid()) @db.Uuid
  employeeId      String         @map("employee_id") @db.Uuid
  fromGroupId     String?        @map("from_group_id") @db.Uuid
  toGroupId       String?        @map("to_group_id") @db.Uuid
  status          ApprovalStatus @default(PENDING_APPROVAL)
  submittedById   String?        @map("submitted_by_id") @db.Uuid
  submittedAt     DateTime       @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedById    String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?        @map("rejection_reason")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromGroup       Group?         @relation("MembershipChangeFromGroup", fields: [fromGroupId], references: [id], onDelete: SetNull)
  toGroup         Group?         @relation("MembershipChangeToGroup", fields: [toGroupId], references: [id], onDelete: SetNull)
  submittedBy     User?          @relation("MembershipChangeSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy      User?          @relation("MembershipChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([fromGroupId])
  @@index([toGroupId])
  @@index([status])
  @@map("group_membership_changes")
}

model OvertimeDeclaration {
  id           String         @id @default(uuid()) @db.Uuid
  employeeId   String         @map("employee_id") @db.Uuid
  date         DateTime       @db.Date
  hours        Decimal        @db.Decimal(6, 2)
  rateType     OvertimeRateType @map("rate_type")
  ratePercent  Decimal        @map("rate_percent") @db.Decimal(5, 2)
  reason       String?
  declaredById String?        @map("declared_by") @db.Uuid
  status       ApprovalStatus @default(PENDING_APPROVAL)
  approvedById String?        @map("approved_by") @db.Uuid
  approvedAt   DateTime?      @map("approved_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  declaredBy   User?          @relation("OvertimeDeclarer", fields: [declaredById], references: [id], onDelete: SetNull)
  approvedBy   User?          @relation("OvertimeApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([employeeId, date])
  @@index([status])
